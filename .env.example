# ── LocalStack ─────────────────────────────────────────────
# Required. Container from version 2026.03.0 won't start without this.
# Get one at https://app.localstack.cloud/ (free Hobby tier is fine for local use).
LOCALSTACK_AUTH_TOKEN=

# Endpoint the pipeline talks to. Change only if LocalStack runs elsewhere.
LOCALSTACK_ENDPOINT=http://localhost:4566

# ── AWS creds for LocalStack ───────────────────────────────
# Values are ignored by LocalStack — the SDK just requires them to be non-empty.
# Included here so raw `aws` CLI calls against LocalStack work without extra flags;
# `make` targets and the Python client hardcode them internally.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=ap-southeast-2

# ── Real AWS (used by `make test-aws`, `make tf-apply-aws`, etc.) ──
AWS_PROFILE_REAL=finance-platform-aws
AWS_ACCOUNT_ID=
# Bucket prefix used when asserting against real AWS. Must match the
# `bucket_prefix` in part1_infrastructure/aws/terraform.tfvars.
AWS_TEST_BUCKET_PREFIX=aaron-fdp-
